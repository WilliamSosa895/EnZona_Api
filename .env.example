# =====================================================================
#  EnZona API — variables de entorno
#  Copia este archivo como .env y llena los valores. NUNCA subas .env.
#  Para generar claves aleatorias de 32 bytes en Base64:
#      openssl rand -base64 32
# =====================================================================

# --- Base de datos (PostgreSQL; en Aiven agrega ?sslmode=require) ---
DB_URL=jdbc:postgresql://localhost:5432/enzona
DB_USER=enzona
DB_PASSWORD=cambia-esta-contrasena
DB_POOL_MAX=8

# --- Perfil de Spring: dev | prod ---
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# --- JWT (sesiones). Base64, mínimo 32 bytes ---
JWT_SECRET=
JWT_ISSUER=enzona-api
JWT_EXPIRATION_MINUTES=60

# --- Firma HMAC-SHA256 de los boletos (RNF-02). Base64, mínimo 32 bytes ---
TICKET_HMAC_SECRET=

# --- CURP (RNF-03): cifrado AES-256-GCM e índice ciego. Base64, 32 bytes cada una ---
# Cambiar CURP_ENCRYPTION_KEY vuelve ilegibles los CURP ya guardados: respáldala.
CURP_ENCRYPTION_KEY=
CURP_INDEX_KEY=

# --- Órdenes y reservas ---
ORDER_RESERVATION_MINUTES=10
ORDER_MAX_TICKETS=10

# --- Códigos de verificación (OTP) y bloqueo de sesión ---
OTP_VALIDITY_MINUTES=10
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Pasarela de pago: sandbox (simulada) mientras no se contrate una real ---
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=

# --- Notificaciones: log (desarrollo) | smtp (correo real) ---
NOTIFICATIONS_MODE=log
MAIL_FROM=no-reply@enzona.mx
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# --- Eventos ---
EVENT_DEFAULT_DURATION_HOURS=6
EVENT_MAX_RADIUS_KM=50

# --- Administrador inicial (opcional; se crea solo si no existe) ---
ADMIN_NAME=Administrador EnZona
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Portadas de eventos: local (archivos en IMAGE_LOCAL_DIR, servidos en /api/imagenes) | cloudinary ---
IMAGE_PROVIDER=local
IMAGE_LOCAL_DIR=./imagenes
IMAGE_MAX_MB=5
# Solo con IMAGE_PROVIDER=cloudinary (Dashboard de Cloudinary > API Keys). Nunca la compartas con el cliente.
CLOUDINARY_URL=
# Moderación de portadas ANTES de guardarlas: off (solo desarrollo) | sightengine | cloudinary (add-on AWS Rekognition).
# Rechaza desnudez, contenido sexual, violencia gráfica y autolesiones por encima del umbral (0 a 1).
IMAGE_MODERATION=off
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
IMAGE_MODERATION_THRESHOLD=0.7

# --- CORS: orígenes de la aplicación web, separados por coma ---
CORS_ORIGINS=http://localhost:5173

# --- Swagger UI en producción ---
SWAGGER_ENABLED=false
