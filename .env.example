# =====================================================================
#  EnZona API — variables de entorno
#  Copia este archivo como .env y llena los valores. NUNCA subas .env.
#  Para generar claves aleatorias de 32 bytes en Base64:
#      openssl rand -base64 32
# =====================================================================

# --- Base de datos (PostgreSQL; en Aiven agrega ?sslmode=require) ---
DB_URL=jdbc:postgresql://localhost:5432/enzona
DB_USER=enzona
DB_PASSWORD=cambia-esta-contrasena
DB_POOL_MAX=8

# --- Perfil de Spring: dev | prod ---
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# --- JWT (sesiones). Base64, mínimo 32 bytes ---
JWT_SECRET=
JWT_ISSUER=enzona-api
JWT_EXPIRATION_MINUTES=60

# --- Firma HMAC-SHA256 de los boletos (RNF-02). Base64, mínimo 32 bytes ---
TICKET_HMAC_SECRET=

# --- CURP (RNF-03): cifrado AES-256-GCM e índice ciego. Base64, 32 bytes cada una ---
# Cambiar CURP_ENCRYPTION_KEY vuelve ilegibles los CURP ya guardados: respáldala.
CURP_ENCRYPTION_KEY=
CURP_INDEX_KEY=

# --- Órdenes y reservas ---
ORDER_RESERVATION_MINUTES=10
ORDER_MAX_TICKETS=10

# --- Códigos de verificación (OTP) y bloqueo de sesión ---
OTP_VALIDITY_MINUTES=10
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Pasarela de pago: sandbox (simulada) mientras no se contrate una real ---
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=

# --- Notificaciones: log (desarrollo) | smtp (correo real) ---
NOTIFICATIONS_MODE=log
MAIL_FROM=no-reply@enzona.mx
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
# Contraseña SMTP. Si usas RESEND_API_KEY déjala comentada: una MAIL_PASSWORD definida pero vacía la anula.
# MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# Opcionales (estos son los valores por defecto): STARTTLS obligatorio, TLS implícito (puertos 465/2465),
# tiempos de espera en milisegundos y si el servidor de correo cuenta en /actuator/health.
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL=false
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000
MAIL_HEALTH_ENABLED=false

# --- Resend por SMTP (guía: docs/CORREO_RESEND.md). Descomenta estas líneas en lugar de las anteriores ---
# NOTIFICATIONS_MODE=smtp
# MAIL_HOST=smtp.resend.com
# Puerto 587 o 2587 con STARTTLS; 465 o 2465 requieren MAIL_SSL=true
# MAIL_PORT=587
# MAIL_USERNAME=resend
# API key de Resend (Dashboard > API Keys, permiso Sending access; se muestra una sola vez). NUNCA la subas.
# RESEND_API_KEY=
# No definas MAIL_PASSWORD vacía: anula a RESEND_API_KEY (el respaldo solo aplica cuando MAIL_PASSWORD no está definida).
# Sin dominio verificado, Resend solo entrega al correo del dueño de la cuenta: este remitente es solo para pruebas.
# MAIL_FROM="EnZona <onboarding@resend.dev>"
# En producción, una dirección de un dominio verificado en resend.com/domains:
# MAIL_FROM="EnZona <no-reply@tu-dominio.mx>"

# --- Eventos ---
EVENT_DEFAULT_DURATION_HOURS=6
EVENT_MAX_RADIUS_KM=50

# --- Administrador inicial (opcional; se crea solo si no existe) ---
ADMIN_NAME=Administrador EnZona
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- CORS: orígenes de la aplicación web, separados por coma ---
CORS_ORIGINS=http://localhost:5173

# --- Swagger UI en producción ---
SWAGGER_ENABLED=false
